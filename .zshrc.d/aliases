#!/bin/bash

# Custom aliases

alias aliasdef="nano ~/.zshrc.d/aliases"
alias apt-get="sudo apt-get"
alias chgrp="chgrp --preserve-root"
alias chmod="chmod --preserve-root"
alias chown="chown --preserve-root"
alias clr="clear"
alias devel="cs ~/devel"
alias dfh="df -h"
alias dn="dolphin"
alias dl="cs ~/Downloads"
alias dnf="sudo dnf"
alias duh="du -shc *"
alias fping="ping -c 100 -i 0.2"
alias funcdef="nano ~/.zshrc.d/functions"
alias gpp="git pull --prune"
alias gpumeminfo="grep -i --color memory /var/log/Xorg.0.log"
alias gstuk="git stash --include-untracked --keep-index"
alias h="history"
alias hh="cat ~/stash/zsh/.zsh_history"
alias home="cs ~"
alias krestart="kquitapp5 plasmashell && kstart5 plasmashell"
alias la="ls -lahF"
alias lad="la | grep ^d"
alias laf="la | grep ^-"
alias lal="la | grep ^l"
alias md="mkdir -pv"
alias now="date +%T"
alias path='printf "%s\n" "$PATH" | tr ":" "\n"'
alias ping="ping -c 5"
alias ports="netstat -tulanp"
alias raminfo="sudo dmidecode --type 17"
alias reboot="sudo shutdown -r now"
alias rm="rm -I --preserve-root"
alias rs42="redshift -O 4200 -v"
alias rsx="redshift -x"
alias shutdown="sudo shutdown -h now"
alias spdtest="wget -O /dev/null http://speedtest.tele2.net/10GB.zip"
alias syncprg="watch -d grep -e Dirty: -e Writeback: /proc/meminfo"
alias today="date +%d-%m-%Y"
alias vardef="nano ~/.zshrc.d/vars"
alias vendef="nano ~/.zshrc.d/vendor"
alias wanip="wanip4"
alias wanip4="dig @ns1.google.com TXT o-o.myaddr.l.google.com +short -4"
alias wanip6="dig @ns1.google.com TXT o-o.myaddr.l.google.com +short -6"
alias wreq="dnf repoquery -i -q --installed --whatrequires"
